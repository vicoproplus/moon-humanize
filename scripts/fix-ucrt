#!/usr/bin/env bash
# fix-ucrt — wrapper that invokes the Windows UCRT repair patch.
#
# On Windows it runs scripts/fix-ucrt.ps1 with PowerShell/PowerShell Core.
# On other platforms there is nothing to fix (UCRT is Windows-only), so it
# just prints a friendly notice and exits 0.
#
# Usage:
#   scripts/fix-ucrt                 # auto-detect moonrun.exe
#   scripts/fix-ucrt --target FILE   # repair a specific binary
#   scripts/fix-ucrt --force         # re-copy even if present
#   scripts/fix-ucrt --what-if       # report only
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PS1="$SCRIPT_DIR/fix-ucrt.ps1"

case "$(uname -s)" in
  *_NT* | MINGW* | MSYS* | CYGWIN*)
    ARGS=()
    for a in "$@"; do ARGS+=("$a"); done
    # Prefer pwsh (PowerShell Core), fall back to powershell.exe
    if command -v pwsh >/dev/null 2>&1; then
      exec pwsh -NoProfile -ExecutionPolicy Bypass -File "$PS1" "${ARGS[@]}"
    elif command -v powershell >/dev/null 2>&1; then
      exec powershell -NoProfile -ExecutionPolicy Bypass -File "$PS1" "${ARGS[@]}"
    else
      echo "fix-ucrt: PowerShell is required to run the UCRT patch on Windows." >&2
      exit 1
    fi
    ;;
  *)
    echo "fix-ucrt: not a Windows host — UCRT DLL repair is not needed here."
    exit 0
    ;;
esac
